---
import TaxonomyListPage from '../../../components/TaxonomyListPage.astro';
import { getCategories } from '../../../lib/taxonomy';

export async function getStaticPaths() {
  const categories = await getCategories('pt-BR');
  return categories.map((c) => ({ params: { category: c.slug }, props: c }));
}

const { name, posts, slug } = Astro.props;
---

<TaxonomyListPage
  locale="pt-BR"
  name={name}
  posts={posts}
  translationPath={`/categories/${slug}/`}
  kicker="Categoria"
/>

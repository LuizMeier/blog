---
// Mesmo ID do Google Analytics já em uso no site atual (_config.yml,
// analytics.google.id) - mantém continuidade do histórico de dados.
const GA_ID = 'G-CQRJCZ1RJL';
---

<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script is:inline define:vars={{ GA_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('js', new Date());
  gtag('config', GA_ID);
</script>

---
import { localeUrl } from '../lib/urls';
import { slugFromId, type Locale } from '../lib/posts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'posts'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { title, description, date, categories, image } = entry.data;
const href = localeUrl(locale, `/posts/${slugFromId(entry.id)}/`);
const dateFmt = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'pt-BR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(date);
---

<a class="card" href={href}>
  {image && <img class="thumb" src={image} alt="" loading="lazy" />}
  <div class="body">
    <div class="meta">
      <span class="category">{categories[0]}</span>
      <time datetime={date.toISOString()}>{dateFmt}</time>
    </div>
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    padding-block: 18px;
    border-bottom: 1px solid var(--color-border);
  }
  .thumb {
    flex: none;
    width: 112px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin: 0;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 0.74rem;
    color: var(--color-muted-fg);
  }
  h2 {
    margin: 0;
    font-size: 1.05rem;
  }
  p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-muted-fg);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card:hover h2 {
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .thumb {
      width: 84px;
    }
  }
</style>

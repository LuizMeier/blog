---
import type { Locale } from '../lib/posts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const text =
  locale === 'en'
    ? `© ${year} Luiz Meier. Content protected by copyright.`
    : `© ${year} Luiz Meier. Conteúdo protegido por direitos autorais.`;

const links = [
  { label: 'GitHub', href: 'https://github.com/LuizMeier' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/luiz-fernando-mizael-meier/' },
  { label: 'Medium', href: 'https://medium.lmeier.net' },
  { label: 'RSS', href: locale === 'en' ? '/rss.xml' : '/pt-BR/rss.xml' }
];
---

<footer class="site-footer">
  <div class="wrap bar">
    <p class="copy">{text}</p>
    <nav class="links">
      {
        links.map((l) => (
          <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 48px;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
    flex-wrap: wrap;
  }
  .copy {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-muted-fg);
  }
  .links {
    display: flex;
    gap: 14px;
    font-family: var(--font-display);
    font-size: 0.8rem;
  }
  .links a {
    text-decoration: none;
    color: var(--color-muted-fg);
  }
  .links a:hover {
    color: var(--color-fg);
  }
</style>
